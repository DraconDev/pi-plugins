  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit -p tsconfig.json",
    "release:check": "npm run check"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "extension",
    "retry",
    "resilience",
    "provider",
    "error",
    "unreliable",
    "ai",
    "llm",
    "backoff"
  ],
  "author": {
    "name": "DraconDev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DraconDev/pi-plugins.git",
    "directory": "extensions/pi-retry-on-error"
  },
  "bugs": {
    "url": "https://github.com/DraconDev/pi-plugins/issues"
  },
  "homepage": "https://github.com/DraconDev/pi-plugins/tree/main/extensions/pi-retry-on-error#readme",
  "files": [
    "index.ts",
    "README.md",
    "package.json",
    "tsconfig.json",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
