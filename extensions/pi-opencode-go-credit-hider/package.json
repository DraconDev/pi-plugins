{
	"name": "pi-opencode-go-credit-hider",
	"version": "0.1.0",
	"description": "Hide the $15-credit-tier models from pi's opencode-go provider by parsing the docs page on every startup.",
	"type": "module",
	"main": "index.ts",
	"files": [
		"index.ts",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/DraconDev/pi-plugins",
		"directory": "extensions/pi-opencode-go-credit-hider"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"extension",
		"opencode",
		"opencode-go",
		"model",
		"credit",
		"filter"
	],
	"author": {
		"name": "DraconDev"
	},
	"license": "MIT",
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"clean": "echo 'nothing to clean'",
		"build": "echo 'Pi loads index.ts directly; no build step'",
		"check": "bunx tsc --noEmit"
	}
}
