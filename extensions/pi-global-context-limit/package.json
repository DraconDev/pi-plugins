{
  "name": "pi-global-context-limit",
  "version": "1.1.0",
  "description": "Caps every model's contextWindow to a single configurable limit, including extension-registered providers",
  "keywords": [
    "pi-package",
    "context-limit",
    "context-window",
    "compaction"
  ],
  "type": "module",
  "license": "MIT",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "echo 'Nothing to build — Pi loads TypeScript directly'",
    "test": "echo 'No tests yet'",
    "clean": "rm -rf node_modules"
  },
  "pi": {
    "extensions": [
      "./extensions/global-context-limit.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dracon/pi-plugins",
    "directory": "extensions/pi-global-context-limit"
  },
  "author": "Dracon"
}
