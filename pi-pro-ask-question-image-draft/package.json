{
  "name": "pi-visual-review",
  "version": "0.1.0",
  "description": "A staged, image-aware replacement for Pi's ask_user_question tool with visual comparison, revision loops, and text fallbacks.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "ask-user-question",
    "visual-review",
    "image-generation",
    "terminal-ui"
  ],
  "files": [
    "extensions",
    "src",
    "scripts",
    "tests",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:tui": "node scripts/verify-tui.mjs",
    "smoke:live": "node scripts/benchmark/smoke-live.mjs",
    "verify:activation": "node scripts/verify-activation.mjs",
    "benchmark:corpus": "node scripts/benchmark/corpus.mjs",
    "benchmark:corpus:validate": "node scripts/benchmark/corpus.mjs --validate",
    "benchmark:compare": "node scripts/benchmark/compare.mjs",
    "benchmark:images": "node scripts/benchmark/images.mjs",
    "benchmark:images:report": "node scripts/benchmark/image-report.mjs",
    "benchmark:images:generate": "node scripts/benchmark/generate-images.mjs",
    "benchmark:judge": "node scripts/benchmark/judge.mjs",
    "benchmark:ledger": "node scripts/benchmark/ledger.mjs",
    "benchmark:publish": "node scripts/benchmark/publish.mjs",
    "benchmark:verify-evidence": "node scripts/benchmark/publish.mjs --verify",
    "benchmark:report": "node scripts/benchmark/report.mjs",
    "benchmark:run": "bash scripts/benchmark/run-all.sh",
    "benchmark:mockups": "node scripts/benchmark/mockups.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/visual-review.ts"
    ]
  }
}
