{
  "name": "pi-visual-review",
  "version": "0.1.0",
  "description": "A staged, image-aware replacement for Pi's ask_user_question tool with visual comparison, revision loops, and text fallbacks.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "ask-user-question",
    "visual-review",
    "image-generation",
    "terminal-ui"
  ],
  "files": [
    "extensions",
    "src",
    "scripts",
    "tests",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:tui": "node scripts/verify-tui.mjs",
    "verify:activation": "node scripts/verify-activation.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/visual-review.ts"
    ]
  }
}
